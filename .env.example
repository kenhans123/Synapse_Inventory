# Copy to .env in the workspace root (keep .env out of git). Never put passwords in chat.
# Either a URL / connection string copied from the portal ...
# SYNAPSE_URL=Server=tcp:myworkspace.sql.azuresynapse.net,1433;Initial Catalog=dm_sales;Encrypt=True;
# ... or server + database
SYNAPSE_SERVER=myworkspace.sql.azuresynapse.net
# serverless: myworkspace-ondemand.sql.azuresynapse.net
SYNAPSE_DATABASE=dm_sales
# token = your current Azure login (az login / VS Code Azure account). Alternatives:
# ActiveDirectoryInteractive (Windows only), ActiveDirectoryServicePrincipal, SqlPassword
SYNAPSE_AUTH=token
# SYNAPSE_SCHEMAS=dm,rpt,mirror
# SYNAPSE_USER=
# SYNAPSE_PASSWORD=
